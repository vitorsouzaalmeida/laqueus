{
  "name": "laqueus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "laqueus": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/dev.ts",
    "build": "tsdown && vite build",
    "test": "vitest run",
    "check-types": "tsc -p . && tsc -p viewer && tsc -p tests && svelte-check --tsconfig ./viewer/tsconfig.json --threshold warning",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript-eslint/scope-manager": "^8.71.2",
    "@typescript-eslint/typescript-estree": "^8.71.2",
    "@typescript-eslint/visitor-keys": "^8.71.2",
    "ignore": "^7.0.5",
    "svelte": "^5.56.4",
    "svelte-eslint-parser": "^1.3.1",
    "typescript": "5.9.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.15.3",
    "@typescript-eslint/types": "^8.71.2",
    "@xyflow/svelte": "^1.7.0",
    "d3-force": "^3.0.0",
    "eslint": "^10.12.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright-core": "^1.64.1",
    "svelte-check": "^4.7.6",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "vite": "^7.1.4",
    "vitest": "^3.2.3"
  }
}
